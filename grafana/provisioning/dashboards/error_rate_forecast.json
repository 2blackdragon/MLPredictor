{
  "title": "Error Rate — Actual vs Predicted",
  "uid": "error-rate-forecast-v1",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now+1h"
  },
  "timezone": "browser",

  "templating": {
    "list": [
      {
        "name": "INFLUXDB_BUCKET",
        "type": "textbox",
        "current": {
          "value": "cpu_monitor",
          "text": "cpu_monitor"
        },
        "hide": 2
      }
    ]
  },

  "panels": [
    {
      "id": 1,
      "title": "Error Rate: Actual vs Predicted (+5 min ahead)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },

      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },

      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Predicted Error Rate (+5m)" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "orange" }
              },
              {
                "id": "custom.lineStyle",
                "value": { "dash": [8, 4] }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Actual Error Rate" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "green" }
              }
            ]
          }
        ]
      },

      "targets": [
        {
          "refId": "A",
          "alias": "Actual Error Rate",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\") |> range(start: v.timeRangeStart) |> filter(fn: (r) => r._measurement == \"error_rate\") |> filter(fn: (r) => r._field == \"value\") |> filter(fn: (r) => r.type == \"actual\") |> drop(columns: [\"metric\", \"type\", \"handler\"])"
        },
        {
          "refId": "B",
          "alias": "Predicted Error Rate (+5m)",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"error_rate\") |> filter(fn: (r) => r._field == \"value\") |> filter(fn: (r) => r.type == \"predicted\" and r.horizon == \"300s\") |> drop(columns: [\"metric\", \"type\", \"horizon\", \"handler\"])"
        }
      ]
    },

    {
      "id": 2,
      "title": "Current Error Rate",
      "type": "stat",
      "gridPos": { "x": 0, "y": 10, "w": 6, "h": 4 },

      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },

      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      },

      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\") |> range(start: v.timeRangeStart) |> filter(fn: (r) => r._measurement == \"error_rate\") |> filter(fn: (r) => r._field == \"value\") |> filter(fn: (r) => r.type == \"actual\") |> drop(columns: [\"metric\", \"type\", \"handler\"]) |> last()"
        }
      ]
    },

    {
      "id": 3,
      "title": "Predicted Error Rate (5 min ahead)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 10, "w": 6, "h": 4 },

      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },

      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      },

      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"error_rate\") |> filter(fn: (r) => r._field == \"value\") |> filter(fn: (r) => r.type == \"predicted\" and r.horizon == \"300s\") |> drop(columns: [\"metric\", \"type\", \"horizon\", \"handler\"]) |> last()"
        }
      ]
    },

    {
      "id": 4,
      "title": "Prediction Absolute Error",
      "type": "stat",
      "gridPos": { "x": 12, "y": 10, "w": 6, "h": 4 },

      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },

      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      },

      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\") |> range(start: v.timeRangeStart) |> filter(fn: (r) => r._measurement == \"error_rate_error\") |> filter(fn: (r) => r._field == \"value\") |> drop(columns: [\"metric\", \"type\", \"handler\"]) |> last()"
        }
      ]
    },

    {
      "id": 5,
      "title": "Collector Lag",
      "type": "stat",
      "gridPos": { "x": 18, "y": 10, "w": 6, "h": 4 },

      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },

      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      },

      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\") |> range(start: v.timeRangeStart) |> filter(fn: (r) => r._measurement == \"collector_lag\") |> filter(fn: (r) => r._field == \"value\") |> drop(columns: [\"metric\", \"type\", \"handler\"]) |> last()"
        }
      ]
    },

    {
      "id": 6,
      "title": "Prediction Error Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 7 },

      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },

      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20
          }
        }
      },

      "targets": [
        {
          "refId": "A",
          "alias": "Abs Error",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\") |> range(start: v.timeRangeStart) |> filter(fn: (r) => r._measurement == \"error_rate_error\") |> filter(fn: (r) => r._field == \"value\") |> drop(columns: [\"metric\", \"type\", \"handler\"])"
        }
      ]
    }
  ]
}