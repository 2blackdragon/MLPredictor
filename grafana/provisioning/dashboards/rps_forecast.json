{
  "title": "RPS \u2014 Actual vs Predicted",
  "uid": "rps-forecast-v1",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now+5m"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "RPS: Actual vs Predicted (+2.5 min ahead)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Predicted RPS (+2.5m)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    4
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Actual RPS"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"rps\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> filter(fn: (r) => r.type == \"actual\")",
          "alias": "Actual RPS"
        },
        {
          "refId": "B",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\")\n  |> range(start: -15m, stop: 5m)\n  |> filter(fn: (r) => r._measurement == \"rps\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> filter(fn: (r) => r.type == \"predicted\" and r.horizon == \"150s\")",
          "alias": "Predicted RPS (+2.5m)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Current RPS",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "InfluxDB"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          },
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"rps\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> filter(fn: (r) => r.type == \"actual\")\n  |> last()",
          "alias": "Actual RPS"
        }
      ]
    },
