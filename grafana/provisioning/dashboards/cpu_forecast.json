{
  "title": "CPU Usage — Actual vs Predicted",
  "uid": "cpu-forecast-v1",
  "schemaVersion": 38,
  "version": 4,
  "refresh": "15s",
  "time": { "from": "now-15m", "to": "now+5m" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "CPU: Actual vs Predicted (+2.5 min ahead)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Predicted CPU (+2.5m)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Actual CPU" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"cpu_usage\")\n  |> filter(fn: (r) => r._field == \"percent\")\n  |> filter(fn: (r) => r.type == \"actual\")",
          "alias": "Actual CPU"
        },
        {
          "refId": "B",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\")\n  |> range(start: -15m, stop: 5m)\n  |> filter(fn: (r) => r._measurement == \"cpu_usage\")\n  |> filter(fn: (r) => r._field == \"percent\")\n  |> filter(fn: (r) => r.type == \"predicted\" and r.horizon == \"150s\")",
          "alias": "Predicted CPU (+2.5m)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Current CPU %",
      "type": "stat",
      "gridPos": { "x": 0, "y": 10, "w": 6, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"cpu_usage\")\n  |> filter(fn: (r) => r._field == \"percent\")\n  |> filter(fn: (r) => r.type == \"actual\")\n  |> last()",
          "alias": "Actual"
        }
      ]
    },
    {
      "id": 3,
      "title": "Predicted CPU in 2.5 min",
      "type": "stat",
      "gridPos": { "x": 6, "y": 10, "w": 6, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\")\n  |> range(start: -15m, stop: 5m)\n  |> filter(fn: (r) => r._measurement == \"cpu_usage\")\n  |> filter(fn: (r) => r._field == \"percent\")\n  |> filter(fn: (r) => r.type == \"predicted\" and r.horizon == \"150s\")\n  |> last()",
          "alias": "Predicted (+2.5m)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Prediction Error (|actual - predicted|)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 10, "w": 6, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"prediction_error\")\n  |> filter(fn: (r) => r._field == \"absolute_percent\")\n  |> last()",
          "alias": "Error"
        }
      ]
    },
    {
      "id": 5,
      "title": "Collector Health (lag seconds)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 10, "w": 6, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 45 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"collector\")\n  |> filter(fn: (r) => r._field == \"lag_seconds\")\n  |> last()",
          "alias": "Lag"
        }
      ]
    },
    {
      "id": 6,
      "title": "Prediction Error Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 7 },
      "datasource": { "type": "influxdb", "uid": "InfluxDB" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "lineWidth": 1, "fillOpacity": 20 }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${INFLUXDB_BUCKET}\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"prediction_error\")\n  |> filter(fn: (r) => r._field == \"absolute_percent\")",
          "alias": "Abs Error %"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "INFLUXDB_BUCKET",
        "type": "textbox",
        "current": { "value": "cpu_monitor", "text": "cpu_monitor" },
        "hide": 2
      }
    ]
  }
}
